const libpesec_io = if (__platform == "linux")
    import "../std/libpesec_io.so"
else null;

if (!libpesec_io) panic "Unsupported platform";

const stdin  = 0;
const stdout = 1;
const stderr = 2;

const input = fn() return libpesec_io.read_line(stdin);

const print = fn(*text) for i in text libpesec_io.write(stdout, i);

const open = fn(path, mode) {
    const fd = libpesec_io.open(path, mode);
    return struct {
        const fd = fd;
        const mode = mode;
        mutab is_open = true;
        const libpesec_io = libpesec_io;

        const write = fn(data) {
            if (this.is_open) {
                this.libpesec_io.write(this.fd, data);
            } else {
                panic "Stream is closed";
            };
        };

        const read = fn(size) {
            if (this.is_open) {
                this.libpesec_io.read(this.fd, size);
            } else {
                panic "Stream is closed";
            };
        };

        const close = fn() {
            this.is_open = false;
            this.libpesec_io.close(this.fd);
        };
    };
};
